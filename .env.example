# ==============================================================================
# Environment Configuration Template
# Copy this file to .env for local development
# NEVER commit sensitive secrets to source control
# ==============================================================================

# Node Environment
NODE_ENV=development

# API Server Configuration
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:3000

# Security and Cryptography Keys
SESSION_SECRET=sso-insecure-dev-session-secret-at-least-32-chars-key
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sso_iam
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database Connection URL (used by Drizzle ORM and API)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sso_iam
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Frontend Configuration
VITE_API_URL=http://localhost:3000
